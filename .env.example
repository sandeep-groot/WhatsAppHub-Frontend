/**
 * .env.example - Copy this file to .env.local and fill in the values
 */

# API — use same-origin /v1 so SameSite=Strict HttpOnly cookies are sent (proxied to backend).
NEXT_PUBLIC_API_URL=/v1
API_PROXY_TARGET=http://localhost:5000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=WhatsAppHub

# Optional: Authentication
# NEXT_AUTH_URL=http://localhost:3000
# NEXT_AUTH_SECRET=your-secret-key-here

# Optional: Feature flags
# NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Facebook & YCloud Embedded Signup Configuration
NEXT_PUBLIC_FB_APP_ID=your-facebook-app-id-here
NEXT_PUBLIC_FB_CONFIG_ID=your-facebook-configuration-id-here
NEXT_PUBLIC_YCLOUD_SOLUTION_ID=your-ycloud-solution-id-here
